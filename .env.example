PORT=5001
NODE_ENV=development
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=generate-with-node-e-require-crypto-randomBytes-32-toString-hex

# Public HTTPS URL for Twilio WhatsApp StatusCallback (required for delivery status).
# Local dev: run `ngrok http 5001` and paste the https URL (no trailing slash).
# Example: PUBLIC_BASE_URL=https://abc123.ngrok-free.app
PUBLIC_BASE_URL=

# AutoDraft (Fathom webhook). Enable per user via PATCH /api/v1/settings { "autoDraftEnabled": true }.
# Requires PUBLIC_BASE_URL and the user's Fathom API key in Settings.
# Dev only: set to true to accept unsigned test deliveries. Ignored when NODE_ENV=production.
FATHOM_WEBHOOK_SKIP_VERIFY=false
