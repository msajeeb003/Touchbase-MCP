generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  passwordHash    String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  settings        UserSettings?
  leads           Lead[]
  transcripts     LeadTranscript[]
  promptTemplates PromptTemplate[]

  @@map("users")
}

model Lead {
  id            String           @id @default(uuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  email         String
  phone         String
  company       String
  location      String
  status        String           @default("Processing")
  followUpStage String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  transcripts   LeadTranscript[]

  @@unique([userId, email])
  @@index([userId])
  @@map("leads")
}

model LeadTranscript {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId            String
  lead              Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  source            String
  fathomRecordingId Int?
  meetingTitle      String
  meetingDate       DateTime
  transcript        String   @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([leadId])
  @@index([userId])
  @@map("lead_transcripts")
}

model PromptTemplate {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  followUpStage String
  promptText    String   @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, followUpStage])
  @@index([userId])
  @@map("prompt_templates")
}

model UserSettings {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // AI Configuration
  aiProvider        String?  // "openai" | "gemini"
  aiApiKey          String?  // AES-256-GCM encrypted
  aiModel           String?

  // Fathom Integration
  fathomApiKey      String?  // AES-256-GCM encrypted

  // SMTP Configuration
  smtpHost          String?
  smtpPort          Int?
  smtpUsername      String?
  smtpPassword      String?  // AES-256-GCM encrypted
  smtpFromName      String?

  // TextMagic SMS
  textmagicUsername String?
  textmagicApiKey   String?  // AES-256-GCM encrypted

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("user_settings")
}
