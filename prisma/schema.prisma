generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  passwordHash    String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  settings        UserSettings?
  leads           Lead[]
  transcripts     LeadTranscript[]
  promptTemplates PromptTemplate[]
  sequences         Sequence[]
  sequenceGoals     SequenceGoal[]
  leadInboundEmails LeadInboundEmail[]
  imapSyncState     ImapSyncState?
  suppressedContacts SuppressedContact[]
  agentRuns          AgentRun[]
  apiTokens          ApiToken[]
  oauthCodes         OAuthAuthCode[]
  oauthGrants        OAuthGrant[]

  @@map("users")
}

model SequenceGoal {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, label])
  @@index([userId])
  @@map("sequence_goals")
}

model Lead {
  id            String           @id @default(uuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  email         String?
  phone         String?
  notes         String?
  company       String?
  location      String?
  status        String           @default("Not Active")
  followUpStage String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  transcripts       LeadTranscript[]
  sequences         Sequence[]
  inboundEmails     LeadInboundEmail[]

  // AI harness: do-not-contact. Fast flag for lists; the checks use suppressed_contacts.
  doNotContact       Boolean   @default(false)
  doNotContactAt     DateTime?
  doNotContactReason String?
  doNotContactSource String? // "mcp" | "user" | "system" | "lead_opt_out"

  // AI harness: soft delete by Claude. Hidden everywhere; restorable in the app for 30 days.
  deletedAt     DateTime?
  deletedReason String?
  deletedBy     String? // "claude" | "user"

  @@unique([userId, email])
  @@index([userId])
  @@map("leads")
}

model LeadTranscript {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId            String
  lead              Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  source            String
  fathomRecordingId Int?
  meetingTitle      String
  meetingDate       DateTime
  transcript        String   @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([leadId])
  @@index([userId])
  @@map("lead_transcripts")
}

model PromptTemplate {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  followUpStage String
  promptText    String   @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sequences     Sequence[]

  @@unique([userId, followUpStage])
  @@index([userId])
  @@map("prompt_templates")
}

model Sequence {
  id               String          @id @default(uuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId           String
  lead             Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  promptTemplateId String?
  promptTemplate   PromptTemplate? @relation(fields: [promptTemplateId], references: [id], onDelete: SetNull)
  name             String
  totalSteps       Int
  status           String          @default("draft")

  // Wizard (generate-save) fields — null on sequences created via the classic flow
  situationType    String?
  situationPrompt  String?         @db.Text
  goal             String?
  tone             String?
  intensity        String?
  cadence          String?
  channels         Json?

  // Legacy columns added directly on production (migration 20260625000000); unused by the app
  intervalDays     Int?
  situation        String?

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  steps            SequenceStep[]
  activities       SequenceActivity[]

  // AI harness
  runId               String? // the run (one user instruction) that created it; null for app-made sequences
  run                 AgentRun? @relation(fields: [runId], references: [id], onDelete: NoAction, onUpdate: Cascade)
  approvalStatus      String    @default("none") // "none" | "awaiting_approval" | "approved"
  approvalRequestedAt DateTime?
  approvedAt          DateTime?
  approvedByUserId    String?
  approvedContentHash String? // hash of the steps at the moment a person activated the sequence
  approvedByActor     String? // "user" | "claude": who released it
  pausedReason        String? // "lead_replied" | "paused_by_claude" | "paused_by_user"
  pausedAt            DateTime?

  @@index([userId])
  @@index([leadId])
  @@unique([runId, leadId])
  @@index([runId])
  @@map("sequences")
}

model SequenceStep {
  id          String    @id @default(uuid())
  sequenceId  String
  sequence    Sequence  @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  stepOrder   Int
  stepType    String
  subject     String?
  content     String?   @db.Text
  status      String    @default("pending")
  scheduledAt DateTime
  sentAt              DateTime?
  sendLog             String?   @db.Text
  externalMessageId   String?   @unique
  createdAt           DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  callLogs    CallLog[]

  activities  SequenceActivity[]

  // AI harness
  runId            String?
  delayMinutes     Int? // delay after the previous step (step 1: after approval); the real date is set at approval
  sendingStartedAt DateTime? // set when the send processor claims the step, just before sending
  deliveryMode     String? // "live" | "mock"
  basis                String? // "transcript" | "notes_and_stage" | "not_stated"
  basedOnTranscriptIds Json?   // up to 3 transcript ids the message was written from
  basedOnNote          String? // one short line on what was taken from the call

  @@unique([sequenceId, stepOrder])
  @@index([sequenceId])
  @@index([runId])
  @@map("sequence_steps")
}

model SequenceActivity {
  id         String        @id @default(uuid())
  sequenceId String
  sequence   Sequence      @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  stepId     String?
  step       SequenceStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)
  eventType  String
  actor      String        @default("system")
  meta       Json          @default("{}")
  createdAt  DateTime      @default(now())

  @@index([sequenceId])
  @@index([sequenceId, createdAt])
  @@map("sequence_activities")
}

model CallLog {
  id                   String   @id @default(uuid())
  stepId               String
  step                 SequenceStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  userId               String
  retellCallId         String   @unique
  callStatus           String
  duration             Int?
  recordingUrl         String?
  transcript           String?  @db.Text
  disconnectionReason  String?
  fromNumber           String?
  toNumber             String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([stepId])
  @@index([userId])
  @@index([retellCallId])
  @@map("call_logs")
}

model UserSettings {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // AI Configuration
  aiProvider        String?  // "openai" | "gemini" | "claude"
  aiApiKey          String?  // AES-256-GCM encrypted
  aiModel           String?

  // Fathom Integration
  fathomApiKey      String?  // AES-256-GCM encrypted

  // SMTP Configuration
  smtpHost          String?
  smtpPort          Int?
  smtpUsername      String?
  smtpPassword      String?  // AES-256-GCM encrypted
  smtpFromName      String?

  // SMS Configuration
  smsProvider       String?  // "textmagic" | "twilio"

  // TextMagic SMS
  textmagicUsername String?
  textmagicApiKey   String?  // AES-256-GCM encrypted

  // Twilio (shared credentials)
  twilioAccountSid      String?
  twilioAuthToken       String?  // AES-256-GCM encrypted
  twilioPhoneNumber     String?  // SMS only
  twilioWhatsappNumber  String?  // WhatsApp only (sandbox or production)

  // Retell AI (calling)
  retellApiKey          String?  // AES-256-GCM encrypted
  retellAgentId         String?
  retellCallerNumber    String?  // E.164; Retell-purchased or Twilio SIP number (must exist in Retell). Falls back to twilioPhoneNumber if unset.

  // Sender profile — added directly on production (migration 20260629120000); unused by the app
  bookingLink        String?
  senderCompany      String?
  senderName         String?
  senderPosition     String?
  serviceDescription String?

  // AutoDraft (Fathom webhook → lead, transcript, draft sequence)
  autoDraftEnabled    Boolean  @default(false)

  // AI harness: send window. Messages go out only inside these hours, in sendTimezone.
  sendWindowStart String  @default("09:00")
  sendWindowEnd   String  @default("18:00")
  sendOnWeekends  Boolean @default(false)
  sendTimezone    String? // IANA name, e.g. "Europe/London". No default on purpose.

  // AI harness: what Claude may do in this workspace. All OFF by default.
  // Changed only by a logged-in person (PATCH /settings). No MCP tool can change them.
  claudeCanActivate          Boolean @default(false)
  claudeCanResume            Boolean @default(false)
  claudeCanEditSettings      Boolean @default(false)
  claudeCanDeleteLeads       Boolean @default(false)
  claudeCanClearDoNotContact Boolean @default(false)
  claudeDailyActivationCap   Int     @default(50)
  fathomWebhookId     String?
  fathomWebhookSecret String?  // AES-256-GCM encrypted

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("user_settings")
}

model LeadInboundEmail {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  messageId  String // email Message-ID, or the SMS provider's message id
  channel    String   @default("email") // "email" | "sms"
  fromEmail  String?  // null for SMS
  fromPhone  String?  // SMS only, as +digits
  fromName   String?
  toEmail    String?
  subject    String?
  bodyText   String   @db.Text
  receivedAt DateTime
  createdAt  DateTime @default(now())

  @@unique([userId, messageId])
  @@index([leadId, receivedAt])
  @@index([userId])
  @@map("lead_inbound_emails")
}

model ImapSyncState {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUid   Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("imap_sync_states")
}

/// AI harness: one row per blocked email address or phone number.
/// Kept when the lead is deleted, so a re-imported address stays blocked.
model SuppressedContact {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind            String // "email" | "phone"
  value           String // lower-cased email, or phone as +digits
  reason          String?
  source          String // "mcp" | "user" | "system" | "lead_opt_out" (the lead asked: no tool can clear it)
  runId           String?
  leadId          String? // the lead it was set from (no foreign key: survives lead deletion)
  createdAt       DateTime  @default(now())
  clearedAt       DateTime? // set only by the human-only REST endpoint
  clearedByUserId String?
  clearReason     String?

  @@unique([userId, kind, value])
  @@index([userId])
  @@map("suppressed_contacts")
}

/// AI harness: one run per instruction the user typed in Claude.
model AgentRun {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  instruction String    @db.Text
  status      String    @default("in_progress") // "in_progress" | "awaiting_approval" | "completed" | "failed" | "abandoned"
  summary     String?   @db.Text
  clientName  String?
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  events    AgentRunEvent[]
  sequences Sequence[]

  @@index([userId, createdAt])
  @@map("agent_runs")
}

/// AI harness: one row per tool call made inside a run.
model AgentRunEvent {
  id         String   @id @default(uuid())
  runId      String
  run        AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  seq        Int // order inside the run: 1, 2, 3 ...
  toolName   String
  summary    String // one line for a person
  ok         Boolean
  errorCode  String?
  touched    Json     @default("[]") // the records it touched: [{ type, id, label }]
  detail     Json? // small facts the server needs later, e.g. which transcript was read
  durationMs Int?
  createdAt  DateTime @default(now())

  @@unique([runId, seq])
  @@map("agent_run_events")
}

/// AI harness: an access token that lets Claude act for one user through /mcp.
/// Only the SHA-256 hash is stored. The token itself is shown once, when it is made.
model ApiToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  prefix     String // first characters of the token, to recognise it in a list
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("api_tokens")
}

/// AI harness, OAuth: an app that may ask users to sign in (for example Claude).
/// Registered by Dynamic Client Registration, or known by its metadata URL (CIMD).
model OAuthClient {
  id           String    @id @default(uuid())
  clientId     String    @unique // "tbc_..." (registered) or the https URL of its metadata document
  clientName   String
  redirectUris Json // list of allowed return addresses
  kind         String // "dcr" | "cimd"
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@map("oauth_clients")
}

/// AI harness, OAuth: a one-time sign-in code. Lives 10 minutes, used once.
model OAuthAuthCode {
  id            String    @id @default(uuid())
  codeHash      String    @unique
  clientId      String
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  redirectUri   String
  codeChallenge String // PKCE, S256
  scope         String
  resource      String
  expiresAt     DateTime
  usedAt        DateTime?
  grantId       String? // the grant the code was exchanged for
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@map("oauth_auth_codes")
}

/// AI harness, OAuth: one user's permission for one app. Revoking it ends every key it issued.
model OAuthGrant {
  id         String       @id @default(uuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId   String
  clientName String
  scope      String
  resource   String
  createdAt  DateTime     @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
  tokens     OAuthToken[]

  @@index([userId])
  @@map("oauth_grants")
}

/// AI harness, OAuth: an access key (1 hour) or a refresh key (30 days, replaced on every use).
/// Only the SHA-256 hash is stored.
model OAuthToken {
  id        String     @id @default(uuid())
  grantId   String
  grant     OAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  kind      String // "access" | "refresh"
  tokenHash String     @unique
  expiresAt DateTime
  usedAt    DateTime? // a refresh key is used once
  revokedAt DateTime?
  createdAt DateTime   @default(now())

  @@index([grantId])
  @@map("oauth_tokens")
}
